---
/**
 * BaseLayout is the primary shell for all pages in the application.
 * It handles the global HTML structure, theme management and background image rotation.
 * Inline scripts here are allowed by CSP hashes that src/integrations/static-headers.mjs
 * computes from the built HTML, so editing them needs no other change.
 */
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getTopbarPersistKey } from '../utils/layout-shell';
import {
  backgroundColorFor,
  backgroundCredit,
  selectBackground,
} from '../utils/background-rotation';
import { buildScenePalette, scenePaletteCss } from '../utils/scene-palette';
interface Props {
  /** The page title used in the <title> tag and OG/Twitter metadata. */
  title: string;
  /** A concise summary of the page for SEO and social sharing. */
  description?: string;
  /** The absolute URL for the canonical link relation, if different from the current URL. */
  canonicalPath?: string;
  /** Controls whether the standard app shell (topbar, navigation) is rendered. */
  shell?: boolean;
  /** Custom OpenGraph image URL or root-relative path (falls back to rotating background). */
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  shell = true,
  ogImage: ogImageProp,
} = Astro.props;
const pathname = Astro.url.pathname;
const pageUrl = new URL(pathname, Astro.site).toString();
const canonical = canonicalPath
  ? new URL(canonicalPath, Astro.site).toString()
  : pageUrl;
const topbarPersistKey = getTopbarPersistKey(shell);

/**
 * The page is prerendered, so the background is picked at build time. CI
 * rebuilds daily (see .github/workflows/ci.yml), which rotates it each day.
 */
const lightImage = selectBackground(new Date());
const lightColorData = backgroundColorFor(lightImage);
/** Colors derived from the photo, contrast-checked (see scene-palette.ts). */
const scenePalette = buildScenePalette(lightColorData);

const lightUnsplash = backgroundCredit(lightImage);

const defaultOgImage = new URL(
  `/backgrounds/light/${lightImage}.jpg`,
  Astro.site
).toString();

const ogImage = ogImageProp
  ? ogImageProp.startsWith('http://') || ogImageProp.startsWith('https://')
    ? ogImageProp
    : new URL(ogImageProp, Astro.site).toString()
  : defaultOgImage;

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/projects/', label: 'Projects' },
];

const isActive = (href: string) => {
  if (href === '/') {
    return pathname === '/';
  }

  return pathname.startsWith(href);
};

const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en" data-theme="ivory">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <ClientRouter />

    <!-- Trusted Types configuration for modern browser security. -->
    <script is:inline>
      if (globalThis.trustedTypes && globalThis.trustedTypes.createPolicy) {
        try {
          if (!globalThis.trustedTypes.defaultPolicy) {
            globalThis.trustedTypes.createPolicy('default', {
              createHTML: (s) => s,
              createScript: (s) => s,
              createScriptURL: (s) => s,
            });
          }
        } catch {}
      }
    </script>
    <!-- Theme and quality-of-service (QoS) initialization.
         Executed inline to prevent Flash of Unstyled Content (FOUC). -->
    <script is:inline>
      (() => {
        try {
          const t = document.documentElement;
          t.dataset.theme = 'ivory';
          const s = sessionStorage.getItem('bg-scene-quality-20260404hq-ivory');
          if (s === 'tiny' || s === 'avif' || s === 'webp' || s === 'default') {
            t.dataset.sceneQuality = s;
          }
        } catch {}
        // Full load from another page of this site (e.g. back from a standalone
        // project page), not a reload or an outside landing: skip the
        // first-visit intro so the switch reads as one app. Must run before
        // first paint; page-transition.ts covers ClientRouter swaps.
        try {
          const activation = globalThis.navigation?.activation;
          const fromSite = activation
            ? activation.from !== null
            : document.referrer.startsWith(location.origin + '/');
          const type =
            activation?.navigationType ??
            performance.getEntriesByType('navigation')[0]?.type;
          if (fromSite && type !== 'reload') {
            document.documentElement.dataset.siteNav = '';
          }
        } catch {}
      })();
    </script>
    <!-- One bundle for the client scripts. Module scripts run deferred, in
         this order, after the background-config block below is parsed. -->
    <script>
      import '../scripts/page-transition.ts';
      import '../scripts/nav-state.ts';
      import '../scripts/scroll-reveal.ts';
      import '../scripts/card-tilt.ts';
      import '../scripts/image-zoom.ts';
      import '../scripts/theme-toggle.ts';
      import '../scripts/background-loader.ts';
    </script>
    <!-- Fetch the scene photo during head parsing: CSS only requests it at the
         first style pass, so a full-load page switch could otherwise reveal the
         page before the photo is in memory. Same URL as --scene-image-avif. -->
    <link
      rel="preload"
      as="image"
      type="image/avif"
      href={`/backgrounds/light/${lightImage}.avif?v=20260404hq`}
    />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="robots" content="index,follow" />
    <meta name="theme-color" content={scenePalette.themeColor} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical ?? pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- Dynamic CSS injection for background image variations.
         Variables are used by CSS to swap background quality levels (AVIF/WebP/Tiny)
         reactively based on client-side feature detection and loading state. -->
    <style
      is:inline
      set:html={`
      :root {
        --scene-image-default: url("/backgrounds/light/${lightImage}.jpg?v=20260404hq");
        --scene-image-tiny: url("/backgrounds/light/${lightImage}.tiny.webp?v=20260404hq");
        --scene-image-webp: url("/backgrounds/light/${lightImage}.webp?v=20260404hq");
        --scene-image-avif: url("/backgrounds/light/${lightImage}.avif?v=20260404hq");
        --scene-image: var(--scene-image-default);
        --scene-color-dominant: ${lightColorData.dominant};
        --scene-color-average: ${lightColorData.average};
        --scene-luminance: ${lightColorData.luminance};
        --scene-is-dark: ${lightColorData.isDark ? '1' : '0'};
      }

      html[data-scene-quality="tiny"] { --scene-image: var(--scene-image-tiny, var(--scene-image-default)); }
      html[data-scene-quality="webp"] { --scene-image: var(--scene-image-webp, var(--scene-image-default)); }
      html[data-scene-quality="avif"] { --scene-image: var(--scene-image-avif, var(--scene-image-default)); }
      html[data-scene-quality="default"] { --scene-image: var(--scene-image-default); }
      ${scenePaletteCss(scenePalette)}
    `}
    ></style>

    <!-- Selected background for background-loader.ts. A JSON data block isn't
         executed, so it needs no CSP hash even though it changes daily. -->
    <script
      is:inline
      type="application/json"
      id="background-config"
      set:html={JSON.stringify({
        ivory: `/backgrounds/light/${lightImage}.jpg`,
      })}
    />
  </head>
  <body>
    <div
      id="nav-progress"
      class="nav-progress"
      aria-hidden="true"
      transition:persist="nav-progress"
    ></div>
    <div id="scene-bg" aria-hidden="true" transition:persist="scene-bg"></div>
    <div
      class="ambient-orb ambient-orb-one"
      aria-hidden="true"
      transition:persist="ambient-orb-one"
    ></div>
    <div
      class="ambient-orb ambient-orb-two"
      aria-hidden="true"
      transition:persist="ambient-orb-two"
    ></div>
    <main class:list={{ 'page-shell': true, 'page-shell-plain': !shell }}>
      {shell ? (
        <section class="app-shell">
          <header class="app-topbar" transition:persist={topbarPersistKey}>
            <div class="app-controls">
              <nav class="app-nav" aria-label="Primary">
                {navItems.map((item) => (
                  <a
                    class:list={{
                      'app-tab': true,
                      'is-active': isActive(item.href),
                    }}
                    data-nav-link
                    data-nav-href={item.href}
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>
          </header>

          <section class="app-content">
            <slot />
          </section>
        </section>
      ) : (
        <>
          <header
            class="app-topbar app-topbar-plain"
            transition:persist={topbarPersistKey}
          >
            <div class="app-controls">
              <nav class="app-nav" aria-label="Primary">
                {navItems.map((item) => (
                  <a
                    class:list={{
                      'app-tab': true,
                      'is-active': isActive(item.href),
                    }}
                    data-nav-link
                    data-nav-href={item.href}
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                ))}
              </nav>
            </div>
          </header>

          <section class="app-content app-content-plain">
            <slot />
          </section>
        </>
      )}
    </main>

    <footer class="site-meta">
      <a
        href={lightUnsplash.url}
        class="bg-credit"
        target="_blank"
        rel="noopener noreferrer"
      >
        Background by {lightUnsplash.author}
      </a>

      <div class="site-footer">&copy; {currentYear} Nick Cardoso</div>
    </footer>

    <style>
      /* Desktop: the two labels float in the bottom corners. */
      .site-meta {
        display: contents;
      }
      .bg-credit,
      .site-footer {
        position: fixed;
        bottom: 1.25rem;
        display: inline-flex;
        align-items: center;
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--text-main);
        text-decoration: none;
        z-index: 50;
        opacity: 0.85;
        transition:
          opacity var(--motion-medium) ease,
          color var(--motion-medium) ease,
          background-color var(--motion-medium) ease,
          border-color var(--motion-medium) ease;
        padding: 0.45rem 0.85rem;
        background: var(--glass-bg);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        border: 1px solid var(--border-color);
        border-radius: 8px;
      }
      .bg-credit {
        left: 1.25rem;
      }
      .site-footer {
        right: 1.25rem;
      }
      .bg-credit:hover,
      .site-footer:hover {
        opacity: 1;
        color: var(--text-main);
        background: var(--button-bg-hover);
        border-color: var(--button-border-strong);
      }
      /* Phones: floating labels would sit over the text the whole time you
         read, so they become a row at the end of the page instead. */
      @media (max-width: 720px) {
        .site-meta {
          display: flex;
          flex-wrap: wrap;
          justify-content: center;
          gap: 0.5rem;
          padding: 0 0.5rem 1.5rem;
        }
        .bg-credit,
        .site-footer {
          position: static;
        }
      }
    </style>
  </body>
</html>
