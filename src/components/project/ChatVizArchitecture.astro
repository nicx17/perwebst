---
/**
 * ChatVizArchitecture component.
 * Renders an accessible, responsive, theme-aware technical illustration of the
 * ChatViz client-side dataflow and security pipeline.
 */
---

<div
  class="chatviz-arch"
  aria-label="ChatViz Client-Side Dataflow Architecture Diagram"
>
  <!-- Top meta header -->
  <header class="arch-header">
    <div class="arch-title-group">
      <div class="arch-badge">
        <svg
          class="arch-badge-icon"
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect x="2" y="2" width="20" height="8" rx="2" ry="2"></rect>
          <rect x="2" y="14" width="20" height="8" rx="2" ry="2"></rect>
          <line x1="6" y1="6" x2="6.01" y2="6"></line>
          <line x1="6" y1="18" x2="6.01" y2="18"></line>
        </svg>
        <span>Client-Side Memory Pipeline</span>
      </div>
      <h3 class="arch-heading">Dataflow & Cryptographic Architecture</h3>
    </div>

    <div
      class="arch-airgap"
      title="Content Security Policy strictly blocks all network egress"
    >
      <span class="airgap-dot" aria-hidden="true"></span>
      <span class="airgap-text">
        <strong>Air Gap:</strong> <code>connect-src 'none'</code> (Zero Outbound
        Requests)
      </span>
    </div>
  </header>

  <!-- Flow Grid Container -->
  <div class="arch-grid">
    <!-- STAGE 01: INGESTION -->
    <div class="arch-column stage-ingestion">
      <div class="column-header">
        <div class="stage-tag">
          <span class="stage-num">01</span>
          <span class="stage-name">Ingestion</span>
        </div>
        <h4 class="column-title">Export Archives</h4>
      </div>

      <div class="column-cards">
        <div class="arch-card item-instagram">
          <div class="card-bar bar-instagram" aria-hidden="true"></div>
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Instagram JSON</span>
            </div>
            <p class="card-desc">
              <code>message_*.json</code> split logs, thread stitching &
              reaction maps
            </p>
          </div>
        </div>

        <div class="arch-card item-snapchat">
          <div class="card-bar bar-snapchat" aria-hidden="true"></div>
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Snapchat JSON</span>
            </div>
            <p class="card-desc">
              <code>chat_history.json</code> full conversation tree and shared
              story media
            </p>
          </div>
        </div>

        <div class="arch-card item-whatsapp">
          <div class="card-bar bar-whatsapp" aria-hidden="true"></div>
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">WhatsApp ZIP / TXT</span>
            </div>
            <p class="card-desc">
              Raw text logs + media-packed archives with dynamic 12h/24h
              timestamp detection
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CONNECTOR 1 -> 2 -->
    <div class="flow-connector" aria-hidden="true">
      <div class="connector-line">
        <span class="connector-pulse pulse-1"></span>
      </div>
      <div class="connector-arrow">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>

    <!-- STAGE 02: EXECUTION -->
    <div class="arch-column stage-worker">
      <div class="column-header">
        <div class="stage-tag tag-worker">
          <span class="stage-num">02</span>
          <span class="stage-name">Execution</span>
        </div>
        <h4 class="column-title">Web Worker</h4>
      </div>

      <div class="column-cards">
        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Inline blob: Worker</span>
            </div>
            <p class="card-desc">
              Offloads 100% of archive parsing and JSON decoding off the main UI
              thread
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Zip64 Streaming Reader</span>
            </div>
            <p class="card-desc">
              Reads media slices directly from the <code>File</code> handle on
              demand without full RAM copies
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Mojibake UTF-8 Repair</span>
            </div>
            <p class="card-desc">
              Corrects broken Instagram Latin-1 byte escapes into native Unicode
              emojis and accents
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CONNECTOR 2 -> 3 -->
    <div class="flow-connector" aria-hidden="true">
      <div class="connector-line">
        <span class="connector-pulse pulse-2"></span>
      </div>
      <div class="connector-arrow">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>

    <!-- STAGE 03: SECURITY -->
    <div class="arch-column stage-security">
      <div class="column-header">
        <div class="stage-tag tag-security">
          <span class="stage-num">03</span>
          <span class="stage-name">Security</span>
        </div>
        <h4 class="column-title">WebCrypto Vault</h4>
      </div>

      <div class="column-cards">
        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">PBKDF2-SHA256</span>
            </div>
            <p class="card-desc">
              600,000 iterations stretch user passphrase with a
              cryptographically random 16-byte salt
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">AES-256-GCM</span>
            </div>
            <p class="card-desc">
              Authenticated symmetric encryption for conversation messages,
              metadata, and media blobs
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">HMAC Key Blinding</span>
            </div>
            <p class="card-desc">
              IndexedDB store keys and participant hashes are blinded against
              physical storage analysis
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- CONNECTOR 3 -> 4 -->
    <div class="flow-connector" aria-hidden="true">
      <div class="connector-line">
        <span class="connector-pulse pulse-3"></span>
      </div>
      <div class="connector-arrow">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </div>
    </div>

    <!-- STAGE 04: INTERFACE -->
    <div class="arch-column stage-ui">
      <div class="column-header">
        <div class="stage-tag tag-ui">
          <span class="stage-num">04</span>
          <span class="stage-name">Interface</span>
        </div>
        <h4 class="column-title">Virtual UI & Storage</h4>
      </div>

      <div class="column-cards">
        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Encrypted IndexedDB</span>
            </div>
            <p class="card-desc">
              Multi-gigabyte persistence across sessions; master decryption key
              lives only in volatile RAM
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">@tanstack/react-virtual</span>
            </div>
            <p class="card-desc">
              Smoothly virtualizes 100,000+ messages at 60 fps with dynamic
              height estimation & sticky dates
            </p>
          </div>
        </div>

        <div class="arch-card">
          <div class="card-body">
            <div class="card-title-row">
              <span class="card-title">Accessible Theme Engine</span>
            </div>
            <p class="card-desc">
              Five contrast-checked themes (Dark, AMOLED, Midnight, Mocha,
              Light) and seven accent shades
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Footer Technical Summary -->
  <footer class="arch-footer">
    <div class="footer-left">
      <span class="footer-label">Stack:</span>
      <code class="footer-stack">
        WebCrypto (SubtleCrypto) + Web Worker + IndexedDB + React 19
      </code>
    </div>
    <div class="footer-right">
      <span>Zero Server Egress</span>
      <span class="footer-sep" aria-hidden="true">
        &bull;
      </span>
      <span>Cloudflare Workers Static Assets</span>
      <span class="footer-sep" aria-hidden="true">
        &bull;
      </span>
      <span>100% In-Memory Processing</span>
    </div>
  </footer>
</div>

<style>
  .chatviz-arch {
    margin: 2rem 0;
    padding: 1.75rem;
    border-radius: 20px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    box-shadow: 0 16px 36px -16px var(--shadow-main);
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    position: relative;
    overflow: hidden;
  }

  /* Header styles */
  .arch-header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border-color);
  }

  .arch-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .arch-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
  }

  .arch-badge-icon {
    color: var(--text-muted);
  }

  .arch-heading {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .arch-airgap {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.08);
    border: 1px solid rgba(34, 197, 94, 0.28);
    font-size: 0.8rem;
    color: var(--text-main);
  }

  .airgap-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulseDot 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes pulseDot {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  .airgap-text code {
    font-size: 0.78rem;
    padding: 0.15rem 0.35rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.08);
    color: inherit;
  }

  /* Grid Layout */
  .arch-grid {
    display: grid;
    grid-template-columns: 1fr auto 1fr auto 1fr auto 1fr;
    align-items: stretch;
    gap: 0.5rem;
  }

  /* Stage Columns */
  .arch-column {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.1rem;
    border-radius: 16px;
    background: var(--button-bg);
    border: 1px solid var(--button-border);
    transition:
      transform var(--motion-hover) var(--ease-sleek),
      border-color var(--motion-medium) ease,
      box-shadow var(--motion-hover) var(--ease-sleek);
  }

  .arch-column:hover {
    transform: translateY(-2px);
    border-color: var(--button-border-strong);
    box-shadow: 0 12px 24px -12px var(--shadow-main);
  }

  .column-header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border-color);
  }

  .stage-tag {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-soft);
  }

  .stage-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 6px;
    font-size: 0.7rem;
    font-weight: 800;
    background: var(--border-color);
    color: var(--text-main);
  }

  .tag-worker .stage-num {
    background: rgba(139, 92, 246, 0.18);
    color: #8b5cf6;
  }

  .tag-security .stage-num {
    background: rgba(16, 185, 129, 0.18);
    color: #10b981;
  }

  .tag-ui .stage-num {
    background: rgba(14, 165, 233, 0.18);
    color: #0ea5e9;
  }

  .column-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-main);
  }

  /* Cards inside Columns */
  .column-cards {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .arch-card {
    display: flex;
    position: relative;
    border-radius: 10px;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.75rem 0.85rem;
    overflow: hidden;
    transition:
      background 160ms ease,
      border-color 160ms ease;
  }

  .arch-card:hover {
    background: var(--button-bg-hover);
    border-color: var(--button-border-strong);
  }

  .card-bar {
    width: 4px;
    border-radius: 4px;
    margin-right: 0.65rem;
    flex-shrink: 0;
  }

  .bar-instagram {
    background: linear-gradient(180deg, #e1306c, #f77737);
  }

  .bar-snapchat {
    background: #eab308;
  }

  .bar-whatsapp {
    background: #22c55e;
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: 100%;
  }

  .card-title-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-title {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-main);
    line-height: 1.3;
  }

  .card-desc {
    margin: 0;
    font-size: 0.76rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .card-desc code {
    font-size: 0.72rem;
    padding: 0.1rem 0.25rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.06);
    color: var(--text-main);
  }

  /* Flow Connectors */
  .flow-connector {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 0 0.25rem;
  }

  .connector-line {
    width: 24px;
    height: 2px;
    background: var(--border-color);
    position: relative;
    overflow: hidden;
  }

  .connector-pulse {
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, #22c55e, transparent);
    animation: flowPulse 2.4s infinite ease-in-out;
  }

  .pulse-2 {
    animation-delay: 0.8s;
  }

  .pulse-3 {
    animation-delay: 1.6s;
  }

  @keyframes flowPulse {
    0% {
      left: -100%;
    }
    100% {
      left: 100%;
    }
  }

  .connector-arrow {
    color: var(--text-soft);
    margin-top: 0.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Footer */
  .arch-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .footer-left {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .footer-label {
    font-weight: 600;
    color: var(--text-main);
  }

  .footer-stack {
    font-size: 0.74rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    background: var(--button-bg);
    border: 1px solid var(--button-border);
    color: var(--text-main);
  }

  .footer-right {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .footer-sep {
    opacity: 0.4;
  }

  /* Responsive Breakpoints */
  @media (max-width: 1100px) {
    .arch-grid {
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }

    .flow-connector {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .chatviz-arch {
      padding: 1.25rem;
      border-radius: 16px;
    }

    .arch-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .arch-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .arch-footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
