    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "^8.21.0"
